<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:clipToOutline="true"
    android:orientation="vertical"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Header: Card Name, Month Tag & Sync Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/btn_sync"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_card_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="SBICRD-S ⚠️"
                android:textColor="#0B132B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:letterSpacing="-0.01" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_month_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge_cyan"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:paddingTop="1.5dp"
                    android:paddingBottom="1.5dp"
                    android:text="OCT"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="SPENT"
                    android:textColor="#64748B"
                    android:textSize="9.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_sync"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_sync_bg"
            android:padding="5dp"
            android:src="@drawable/ic_widget_sync"
            android:alpha="0.85" />
    </RelativeLayout>

    <!-- Center Section: Curved Arc Gauge & Total Spent Hero (scales seamlessly) -->
    <ImageView
        android:id="@+id/iv_gauge"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="18dp"
        android:scaleType="fitCenter" />

    <!-- Bottom Metrics Card (Clean, Symmetrical 50/50 Split - No Icons for Maximum Clarity) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_metric_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp">

        <!-- Limit Tile (50% Width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_limit_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIMIT"
                android:textColor="#64748B"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_max_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹21,000"
                android:textColor="#0B132B"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Elegant Divider Line -->
        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="22dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#E2E8F0" />

        <!-- Remaining Tile (50% Width) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REMAINING"
                android:textColor="#64748B"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tv_remaining_budget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="₹14,573"
                android:textColor="#10B981"
                android:textSize="14.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden compatibility views to retain ID compatibility without visual conflicts -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone">
        <ImageView android:id="@+id/iv_remaining_icon" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/tv_progress_pct" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/tv_spend_subtitle" android:layout_width="0dp" android:layout_height="0dp" />
        <TextView android:id="@+id/tv_current_value" android:layout_width="0dp" android:layout_height="0dp" />
        <ProgressBar android:id="@+id/progress_bar_blue" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="1dp" />
        <ProgressBar android:id="@+id/progress_bar_green" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="1dp" />
        <ProgressBar android:id="@+id/progress_bar_orange" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="1dp" />
        <ProgressBar android:id="@+id/progress_bar_red" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="1dp" />
    </FrameLayout>
</LinearLayout>
